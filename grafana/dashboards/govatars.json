{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Logs",
      "type": "link",
      "url": "/d/govatars-logs/govatars-logs",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=~\"govatars.*\"}[5m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "HTTP latency p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=~\"govatars.*\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "title": "Avatar uploads / min",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(govatars_avatar_uploads_total[5m])) * 60",
          "legendFormat": "uploads",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "title": "Avatar deletes / min",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(govatars_avatar_deletes_total[5m])) * 60",
          "legendFormat": "deletes",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "title": "Thumbnail jobs (ok vs error)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(govatars_thumbnail_jobs_total{status=\"ok\"}[5m])) * 60",
          "legendFormat": "ok",
          "refId": "A"
        },
        {
          "expr": "sum(rate(govatars_thumbnail_jobs_total{status=\"error\"}[5m])) * 60",
          "legendFormat": "error",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "title": "Thumbnail job duration p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(govatars_thumbnail_job_duration_seconds_bucket[5m])) by (le, operation))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "title": "Queue retries & DLQ / min",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(govatars_queue_retries_total[5m])) * 60",
          "legendFormat": "retries",
          "refId": "A"
        },
        {
          "expr": "sum(rate(govatars_queue_dlq_total[5m])) * 60",
          "legendFormat": "dlq",
          "refId": "B"
        }
      ]
    }
  ],
