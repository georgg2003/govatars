{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Metrics",
      "type": "link",
      "url": "/d/govatars-overview/govatars",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }] } },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Errors / min",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate({service_name=~\"$service\"} | json | level=~\"(?i)error\" [$__rate_interval])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "orange", "value": null }] } },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Warnings / min",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate({service_name=~\"$service\"} | json | level=~\"(?i)warn\" [$__rate_interval])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Log lines / min",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate({service_name=~\"$service\"} [$__rate_interval])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 4 },
      "id": 4,
      "title": "Log volume by level",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate({service_name=~\"$service\"} | json | level=~\"(?i)error\" [$__rate_interval]))",
          "legendFormat": "error",
          "refId": "A"
        },
        {
          "expr": "sum(rate({service_name=~\"$service\"} | json | level=~\"(?i)warn\" [$__rate_interval]))",
          "legendFormat": "warn",
          "refId": "B"
        },
        {
          "expr": "sum(rate({service_name=~\"$service\"} | json | level=~\"(?i)info\" [$__rate_interval]))",
          "legendFormat": "info",
          "refId": "C"
        },
        {
          "expr": "sum(rate({service_name=~\"$service\"} | json | level=~\"(?i)debug\" [$__rate_interval]))",
          "legendFormat": "debug",
          "refId": "D"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 4 },
      "id": 5,
      "title": "Log volume by service",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (service_name) (rate({service_name=~\"$service\"} [$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 11 },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "All logs",
      "type": "logs",
      "targets": [
        {
          "expr": "{service_name=~\"$service\"} | json | level=~\"$level\" | trace_id=~\"$trace_id\" | request_id=~\"$request_id\" |~ \"$search\" | line_format \"{{if .trace_id}}trace_id={{.trace_id}} {{end}}{{if .request_id}}request_id={{.request_id}} {{end}}{{if .user_id}}user_id={{.user_id}} {{end}}{{.msg}}\"",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "id": 7,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "HTTP access logs",
      "type": "logs",
      "targets": [
        {
          "expr": "{service_name=~\"govatars_server\"} | json | msg=~\"request completed\" | level=~\"$level\" | trace_id=~\"$trace_id\" | request_id=~\"$request_id\" | line_format \"{{.method}} {{.path}} status={{.status}} latency={{.latency}} request_id={{.request_id}} trace_id={{.trace_id}}\"",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "Errors & warnings",
      "type": "logs",
      "targets": [
        {
          "expr": "{service_name=~\"$service\"} | json | level=~\"(?i)(error|warn)\" | trace_id=~\"$trace_id\" | line_format \"[{{.level}}] {{.msg}} trace_id={{.trace_id}}\"",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["govatars", "observability", "logs", "loki"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "Loki" },
        "definition": "label_values({service_name=~\"govatars.*\"}, service_name)",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "query": "label_values({service_name=~\"govatars.*\"}, service_name)",
        "refresh": 2,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "includeAll": true,
        "label": "Level",
        "multi": false,
        "name": "level",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "error", "value": "ERROR|error" },
          { "selected": false, "text": "warn", "value": "WARN|warn|warning" },
          { "selected": false, "text": "info", "value": "INFO|info" },
          { "selected": false, "text": "debug", "value": "DEBUG|debug" }
        ],
        "query": "error,warn,info,debug",
        "type": "custom"
      },
      {
        "allValue": ".*",
        "current": { "text": "", "value": "" },
        "label": "Trace ID",
        "name": "trace_id",
        "options": [{ "selected": true, "text": "", "value": "" }],
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": { "text": "", "value": "" },
        "label": "Request ID",
        "name": "request_id",
        "options": [{ "selected": true, "text": "", "value": "" }],
        "query": "",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": { "text": "", "value": "" },
        "label": "Search",
        "name": "search",
        "options": [{ "selected": true, "text": "", "value": "" }],
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Govatars Logs",
  "uid": "govatars-logs",
  "version": 1
}
