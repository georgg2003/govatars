{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Metrics",
      "type": "link",
      "url": "/d/govatars-overview/govatars",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }] } },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Errors / min",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate({service_name=~\"$service\"} | severity_text=\"ERROR\" [$__auto])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "orange", "value": null }] } },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Warnings / min",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate({service_name=~\"$service\"} | severity_text=\"WARN\" [$__auto])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Log lines / min",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate({service_name=~\"$service\"} [$__auto])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 4 },
      "id": 4,
      "title": "Log volume by level",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate({service_name=~\"$service\"} | severity_text=\"ERROR\" [$__auto]))",
          "legendFormat": "ERROR",
          "refId": "A"
        },
        {
          "expr": "sum(rate({service_name=~\"$service\"} | severity_text=\"WARN\" [$__auto]))",
          "legendFormat": "WARN",
          "refId": "B"
        },
        {
          "expr": "sum(rate({service_name=~\"$service\"} | severity_text=\"INFO\" [$__auto]))",
          "legendFormat": "INFO",
          "refId": "C"
        },
        {
          "expr": "sum(rate({service_name=~\"$service\"} | severity_text=\"DEBUG\" [$__auto]))",
          "legendFormat": "DEBUG",
          "refId": "D"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 4 },
      "id": 5,
      "title": "Log volume by service",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (service_name) (rate({service_name=~\"$service\"} [$__auto]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 11 },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "All logs",
      "type": "logs",
      "targets": [
        {
          "expr": "{service_name=~\"$service\"} | severity_text=~\"$level\" | trace_id=~\".*$trace_id.*\" | request_id=~\".*$request_id.*\" |~ \".*$search.*\"",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "id": 7,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "HTTP access logs",
      "type": "logs",
      "targets": [
        {
          "expr": "{service_name=~\"govatars_server\"} |= \"request completed\" | severity_text=~\"$level\" | trace_id=~\".*$trace_id.*\" | request_id=~\".*$request_id.*\"",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "Errors & warnings",
      "type": "logs",
      "targets": [
        {
          "expr": "{service_name=~\"$service\"} | severity_text=~\"ERROR|WARN\" | trace_id=~\".*$trace_id.*\"",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["govatars", "observability", "logs", "loki"],
  "templating": {
    "list": [
      {
        "allValue": "govatars.*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(service_name)",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "query": "label_values(service_name)",
        "refresh": 2,
        "regex": "/govatars.*/",
        "type": "query"
      },
      {
        "allValue": "INFO|WARN|ERROR|DEBUG",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "includeAll": true,
        "label": "Level",
        "multi": false,
        "name": "level",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "ERROR", "value": "ERROR" },
          { "selected": false, "text": "WARN", "value": "WARN" },
          { "selected": false, "text": "INFO", "value": "INFO" },
          { "selected": false, "text": "DEBUG", "value": "DEBUG" }
        ],
        "query": "ERROR,WARN,INFO,DEBUG",
        "type": "custom"
      },
      {
        "current": { "text": "", "value": "" },
        "label": "Trace ID",
        "name": "trace_id",
        "options": [{ "selected": true, "text": "", "value": "" }],
        "query": "",
        "type": "textbox"
      },
      {
        "current": { "text": "", "value": "" },
        "label": "Request ID",
        "name": "request_id",
        "options": [{ "selected": true, "text": "", "value": "" }],
        "query": "",
        "type": "textbox"
      },
      {
        "current": { "text": "", "value": "" },
        "label": "Search",
        "name": "search",
        "options": [{ "selected": true, "text": "", "value": "" }],
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Govatars Logs",
  "uid": "govatars-logs",
  "version": 3
}
